#!/bin/sh
# cs-job — provider-blind background job runner for a sidecar agent.
#
# Lets the agent fan out work that OUTLIVES the current turn. Each job is a
# detached (setsid) process whose stdout+stderr, exit code and status are
# captured under /workspace/.cs/jobs/<id>/ (bind-mounted, so results persist
# across turns and even container removal).
#
# Why setsid: the turn runs under `timeout -s KILL` (entrypoint.sh), which
# signals the whole process group on completion/expiry. setsid puts the job in
# a NEW session/group so it escapes that kill and is reaped by catatonit (PID 1,
# --init). Verified empirically before this script existed.
#
# Orphan handling: a job killed by container teardown leaves status=running.
# entrypoint.sh relabels those to "orphaned" at next boot (safe: if entrypoint
# runs, nothing from a prior boot is alive).
#
# Commands:
#   cs-job run -- <cmd...>     detach cmd, print <id>, return immediately.
#                              NOTIFY BY DEFAULT: completion posts job_done to
#                              the ctl plane and the daemon wakes the launching
#                              session with the result. --no-notify opts out
#                              (--notify still accepted, now a no-op).
#   cs-job spawn <prompt...>   = run -- cs-subagent <prompt...>  (LLM fan-out)
#   cs-job list                id / status / rc / session / cmd table
#   cs-job wait <id> [secs]    block until done (default 600s budget) — the
#                              EXPLICIT in-turn join; cancels the job's pending
#                              completion callback, since the caller is
#                              consuming the result right here.
#   cs-job status <id>         print status (running|done|orphaned)
#   cs-job peek [-n N|-new] <id>
#                              NON-BLOCKING progress check: status header +
#                              a bounded slice of the output, returns at once.
#                              The polling counterpart to `wait` — mid-turn
#                              peeking never holds the group hostage.
#   cs-job logs <id>           cat the job's combined output
#   cs-job rm <id>             remove one job dir
#   cs-job clean               remove all non-running job dirs
set -e

JOBS=/workspace/.cs/jobs
LOCK="$JOBS/.lock"
MAX=${CS_MAX_JOBS:-8}
# Byte cap on one `peek`. A peek lands in the agent's context, so an output
# firehose must not be able to blow the turn: we print the TAIL of the slice
# and say how much was skipped.
PEEK_MAX=${CS_PEEK_MAX:-8000}
mkdir -p "$JOBS"

# Job ids are minted as bare alphanumerics (mktemp -u style, see `run`), but
# every id-taking verb took $1 verbatim and pasted it into "$JOBS/$id". Shell
# quoting stops metacharacters; it does not stop "..", so `cs-job rm ../..`
# was an rm -rf of /workspace. The agent owns that directory anyway — this is
# containment of a typo and of a model repeating a malformed id back at
# itself, not of an adversary — but no verb here has any business resolving
# outside $JOBS.
# Called as a STATEMENT, never inside $(...): a command substitution runs in a
# subshell, so an `exit` there only ends the subshell and the caller would go
# on with an empty id — i.e. "$JOBS/" — which for `rm` is worse than the
# traversal being fixed.
chkid() {
  case "${1:-}" in
    ''|.|..|*[!A-Za-z0-9]*) echo "cs-job: invalid job id: ${1:-}" >&2; exit 2 ;;
  esac
}

jstatus() { cat "$JOBS/$1/status" 2>/dev/null || echo unknown; }
count_running() { c=0; for d in "$JOBS"/*/; do [ "$(cat "$d/status" 2>/dev/null)" = running ] && c=$((c+1)); done; echo "$c"; }

cmd=${1:-}; [ $# -gt 0 ] && shift || true
case "$cmd" in
  run)
    # Notify is the DEFAULT: fire-and-forget with a callback is the contract,
    # blocking is the explicit exception (cs-job wait). --notify is kept as an
    # accepted no-op so existing agent habits don't break.
    NOTIFY=1
    case "${1:-}" in
      --notify) shift ;;
      --no-notify) NOTIFY=; shift ;;
    esac
    [ "${1:-}" = "--" ] && shift
    [ $# -eq 0 ] && { echo "cs-job run: no command" >&2; exit 2; }
    # Atomic cap check + dir mint under flock so parallel `run &` can't exceed MAX.
    exec 9>"$LOCK"; flock 9
    running=$(count_running)
    if [ "$running" -ge "$MAX" ]; then
      echo "cs-job: job cap reached ($running/$MAX running); wait or raise CS_MAX_JOBS" >&2
      exit 1
    fi
    D=$(mktemp -d "$JOBS/XXXXXXXX")
    id=$(basename "$D")
    { printf '%s ' "$@"; echo; } > "$D/cmd"
    date +%s > "$D/started"
    # Attribute the job to the chat session whose turn launched it
    # (KOTO_SESSION is exported per turn by entrypoint.sh). The daemon's
    # jobs mirror and the TUI tree nest the job under this session.
    printf '%s' "${KOTO_SESSION:-default}" > "$D/session"
    echo running > "$D/status"
    [ -n "$NOTIFY" ] && : > "$D/notify"   # marker: post job_done to ctl on completion
    flock -u 9
    # Detach: new session escapes the turn's process-group kill; stdio -> files.
    # On completion a notify job posts {"cmd":"job_done"} to the group ctl FIFO;
    # the daemon debounces + coalesces those into one self-send (notify.go).
    setsid sh -c '
      echo $$ > "'"$D"'/pgid"
      exec >"'"$D"'/out" 2>&1
      "$@"
      rc=$?
      echo "$rc" > "'"$D"'/rc"
      # `notifying` is raised BEFORE the status flips to done and cleared after
      # the callback has read rc and out, so `clean` has a window it can see
      # rather than one it can only lose (audit 2026-09-11 L143).
      [ -f "'"$D"'/notify" ] && : > "'"$D"'/notifying"
      echo done > "'"$D"'/status"
      if [ -f "'"$D"'/notify" ]; then
        /sidecar/cs-job _notify "'"$id"'" || true
        rm -f "'"$D"'/notifying"
      fi
    ' _ "$@" &
    # ^ the setsid child is its own session and process-group leader, so its
    #   pid IS the pgid — recorded so `cs-job rm` can terminate the whole group
    #   rather than only deleting the bookkeeping (audit M83). Without it a
    #   removed job kept running, kept writing to a now-unreferenced out file,
    #   and was invisible to `cs-job list`.
    echo "$id"
    ;;
  _notify)
    # internal: post a job_done event to the group ctl FIFO, carrying the job's
    # rc + a base64 tail of its output. Under firecracker the daemon CANNOT read
    # the job dir (it lives inside workspace.img), so the result must ride the
    # ctl payload — see notify.go. The tail is capped at 1500 bytes to match the
    # daemon's old on-host trim; the full output stays readable via cs-job logs.
    # Bounded by timeout so a down ctl reader (daemon stopped) can't hang the
    # detached job — best-effort; the result is still on disk regardless.
    id=${1:?}; chkid "$id"; D=$JOBS/$id
    rc=$(cat "$D/rc" 2>/dev/null || echo '?')
    sess=$(cat "$D/session" 2>/dev/null || echo '')
    # The value lands inside a JSON string; anything outside the session
    # charset would forge fields (audit L11) — drop it to the default session.
    case "$sess" in *[!A-Za-z0-9_-]*) sess='' ;; esac
    total=$(wc -c < "$D/out" 2>/dev/null | tr -d ' '); [ -n "$total" ] || total=0
    # base64 of the last 1500 bytes, newlines stripped so it's one JSON line.
    b64=$(tail -c 1500 "$D/out" 2>/dev/null | base64 | tr -d '\n')
    # session rides along so the daemon wakes the conversation that launched
    # the job, not the group's default one (notify.go).
    printf '{"cmd":"job_done","id":"%s","rc":"%s","total":%s,"session":"%s","out":"%s"}\n' \
      "$id" "$rc" "$total" "$sess" "$b64" | timeout 30 sh -c 'cat > /workspace/.cs/ctl' 2>/dev/null || true
    ;;
  spawn)
    NF=
    case "${1:-}" in
      --notify) NF=--notify; shift ;;
      --no-notify) NF=--no-notify; shift ;;
    esac
    [ $# -eq 0 ] && { echo "cs-job spawn: no prompt" >&2; exit 2; }
    exec "$0" run $NF -- cs-subagent "$@"
    ;;
  list)
    printf '%-10s %-9s %-4s %-12s %s\n' ID STATUS RC SESSION CMD
    for d in "$JOBS"/*/; do
      [ -d "$d" ] || continue
      id=$(basename "$d")
      printf '%-10s %-9s %-4s %-12s %s\n' "$id" "$(cat "$d/status" 2>/dev/null || echo ?)" \
        "$(cat "$d/rc" 2>/dev/null || echo -)" "$(cat "$d/session" 2>/dev/null || echo default)" \
        "$(cat "$d/cmd" 2>/dev/null | head -c 80)"
    done
    ;;
  wait)
    id=${1:?cs-job wait <id> [secs]}; chkid "$id"; budget=${2:-600}
    [ -d "$JOBS/$id" ] || { echo "cs-job: no such job $id" >&2; exit 2; }
    # The caller is consuming the result in-turn — cancel the completion
    # callback so the daemon doesn't ALSO wake the session with a result it
    # already has. Best-effort: a job that completed before this wait started
    # has posted already (nothing to cancel), and a completion racing the rm
    # can still slip one through — a harmless duplicate, not a loss.
    rm -f "$JOBS/$id/notify"
    waited=0
    while [ "$(jstatus "$id")" = running ]; do
      [ "$waited" -ge "$budget" ] && { echo "cs-job: wait timeout ($budget s) — job $id still running" >&2; exit 1; }
      sleep 1; waited=$((waited+1))
    done
    echo "$(jstatus "$id") rc=$(cat "$JOBS/$id/rc" 2>/dev/null || echo unknown)"
    ;;
  peek)
    # Non-blocking look at a running job. `wait` blocks the whole group until
    # the job ends; `peek` reads what exists right now and returns — so an
    # agent can check on a long build mid-turn, or across turns, without
    # stalling the conversation.
    #   peek <id>        last $lines lines
    #   peek -n N <id>   last N lines
    #   peek -new <id>   only what was appended since this job's LAST peek
    #                    (byte cursor in <job>/peek, so successive peeks —
    #                    including from later turns — never repeat output)
    lines=40; mode=tail
    while :; do
      case "${1:-}" in
        -n) lines=${2:?cs-job peek -n <lines>}; shift 2 ;;
        -new|--new) mode=new; shift ;;
        *) break ;;
      esac
    done
    id=${1:?cs-job peek [-n LINES|-new] <id>}; chkid "$id"; D=$JOBS/$id
    [ -d "$D" ] || { echo "cs-job: no such job $id" >&2; exit 2; }
    # 2>/dev/null BEFORE the input redirect: redirections apply left to right,
    # so this is what silences the shell's own error on a job whose `out` does
    # not exist yet (mint → exec race).
    total=$(wc -c 2>/dev/null < "$D/out" | tr -d ' '); [ -n "$total" ] || total=0
    started=$(cat "$D/started" 2>/dev/null || echo '')
    age=-; [ -n "$started" ] && age=$(( $(date +%s) - started ))
    printf '%s %s rc=%s bytes=%s age=%ss\n' "$id" "$(jstatus "$id")" \
      "$(cat "$D/rc" 2>/dev/null || echo -)" "$total" "$age"
    if [ "$mode" = new ]; then
      off=$(cat "$D/peek" 2>/dev/null || echo 0)
      case "$off" in ''|*[!0-9]*) off=0 ;; esac
      # Output truncated/rewritten under us — restart from the top.
      [ "$off" -gt "$total" ] && off=0
      printf '%s' "$total" > "$D/peek"
      if [ "$off" -eq "$total" ]; then
        echo "(no new output)"
      elif [ $((total - off)) -gt "$PEEK_MAX" ]; then
        echo "(skipped $((total - off - PEEK_MAX)) of $((total - off)) new bytes)"
        tail -c "$PEEK_MAX" "$D/out"
      else
        tail -c +$((off + 1)) "$D/out"
      fi
    else
      tail -n "$lines" "$D/out" 2>/dev/null | tail -c "$PEEK_MAX" || true
    fi
    ;;
  status)  chkid "${1:?cs-job status <id>}"; jstatus "$1" ;;
  logs)    chkid "${1:?cs-job logs <id>}"; cat "$JOBS/$1/out" 2>/dev/null || { echo "cs-job: no output for $1" >&2; exit 2; } ;;
  rm)
    chkid "${1:?cs-job rm <id>}"
    # Terminate before forgetting. A detached job outlives its turn by design,
    # so deleting only the metadata left it running against a directory nobody
    # tracks: still consuming CPU and workspace disk, and no longer listed
    # (audit M83). TERM then KILL, to the process GROUP — setsid made the job
    # its own leader, so the negative pid reaches its descendants too.
    PG=$(cat "$JOBS/$1/pgid" 2>/dev/null || echo '')
    case "$PG" in ''|*[!0-9]*) PG='' ;; esac
    if [ -n "$PG" ] && kill -0 "-$PG" 2>/dev/null; then
      kill -TERM "-$PG" 2>/dev/null || true
      n=0
      while [ "$n" -lt 20 ] && kill -0 "-$PG" 2>/dev/null; do
        sleep 0.1; n=$((n+1))
      done
      kill -0 "-$PG" 2>/dev/null && kill -KILL "-$PG" 2>/dev/null || true
    fi
    rm -rf "$JOBS/$1"; echo removed ;;
  clean)
    # Under the SAME lock the mint takes (audit 2026-09-11 L143). The scan ran
    # unlocked, so a directory mktemp'd but not yet carrying its status file
    # read as "not running" and was deleted out from under the caller — who
    # then got back a job id whose directory was already gone and whose output
    # redirection failed.
    n=0
    exec 9>"$LOCK"; flock 9
    for d in "$JOBS"/*/; do
      [ -d "$d" ] || continue
      st=$(cat "$d/status" 2>/dev/null)
      [ "$st" = running ] && continue
      # No status file at all: still being minted. The lock covers the mint
      # itself, but a `run` that has released it is between files.
      [ -z "$st" ] && continue
      # Marked done but its completion callback has not read rc and out yet
      # (the second race: `done` is written BEFORE _notify runs, so deleting
      # here loses the result the agent asked to be woken with).
      [ -f "$d/notifying" ] && continue
      rm -rf "$d"; n=$((n+1))
    done
    flock -u 9
    echo "removed $n"
    ;;
  *)
    echo "usage: cs-job {run [--no-notify] -- <cmd...>|spawn [--no-notify] <prompt...>|list|wait <id> [secs]|status <id>|peek [-n LINES|-new] <id>|logs <id>|rm <id>|clean}" >&2
    exit 2
    ;;
esac
