#!/bin/sh
# cs-job — provider-blind background job runner for a sidecar agent.
#
# Lets the agent fan out work that OUTLIVES the current turn. Each job is a
# detached (setsid) process whose stdout+stderr, exit code and status are
# captured under /workspace/.cs/jobs/<id>/ (bind-mounted, so results persist
# across turns and even container removal).
#
# Why setsid: the turn runs under `timeout -s KILL` (entrypoint.sh), which
# signals the whole process group on completion/expiry. setsid puts the job in
# a NEW session/group so it escapes that kill and is reaped by catatonit (PID 1,
# --init). Verified empirically before this script existed.
#
# Orphan handling: a job killed by container teardown leaves status=running.
# entrypoint.sh relabels those to "orphaned" at next boot (safe: if entrypoint
# runs, nothing from a prior boot is alive).
#
# Commands:
#   cs-job run -- <cmd...>     detach cmd, print <id>, return immediately.
#                              NOTIFY BY DEFAULT: completion posts job_done to
#                              the ctl plane and the daemon wakes the launching
#                              session with the result. --no-notify opts out
#                              (--notify still accepted, now a no-op).
#   cs-job spawn <prompt...>   = run -- cs-subagent <prompt...>  (LLM fan-out)
#   cs-job list                id / status / rc / session / cmd table
#   cs-job wait <id> [secs]    block until done (default 600s budget) — the
#                              EXPLICIT in-turn join; cancels the job's pending
#                              completion callback, since the caller is
#                              consuming the result right here.
#   cs-job status <id>         print status (running|done|orphaned)
#   cs-job logs <id>           cat the job's combined output
#   cs-job rm <id>             remove one job dir
#   cs-job clean               remove all non-running job dirs
set -e

JOBS=/workspace/.cs/jobs
LOCK="$JOBS/.lock"
MAX=${CS_MAX_JOBS:-8}
mkdir -p "$JOBS"

jstatus() { cat "$JOBS/$1/status" 2>/dev/null || echo unknown; }
count_running() { c=0; for d in "$JOBS"/*/; do [ "$(cat "$d/status" 2>/dev/null)" = running ] && c=$((c+1)); done; echo "$c"; }

cmd=${1:-}; [ $# -gt 0 ] && shift || true
case "$cmd" in
  run)
    # Notify is the DEFAULT: fire-and-forget with a callback is the contract,
    # blocking is the explicit exception (cs-job wait). --notify is kept as an
    # accepted no-op so existing agent habits don't break.
    NOTIFY=1
    case "${1:-}" in
      --notify) shift ;;
      --no-notify) NOTIFY=; shift ;;
    esac
    [ "${1:-}" = "--" ] && shift
    [ $# -eq 0 ] && { echo "cs-job run: no command" >&2; exit 2; }
    # Atomic cap check + dir mint under flock so parallel `run &` can't exceed MAX.
    exec 9>"$LOCK"; flock 9
    running=$(count_running)
    if [ "$running" -ge "$MAX" ]; then
      echo "cs-job: job cap reached ($running/$MAX running); wait or raise CS_MAX_JOBS" >&2
      exit 1
    fi
    D=$(mktemp -d "$JOBS/XXXXXXXX")
    id=$(basename "$D")
    { printf '%s ' "$@"; echo; } > "$D/cmd"
    date +%s > "$D/started"
    # Attribute the job to the chat session whose turn launched it
    # (KOTO_SESSION is exported per turn by entrypoint.sh). The daemon's
    # jobs mirror and the TUI tree nest the job under this session.
    printf '%s' "${KOTO_SESSION:-default}" > "$D/session"
    echo running > "$D/status"
    [ -n "$NOTIFY" ] && : > "$D/notify"   # marker: post job_done to ctl on completion
    flock -u 9
    # Detach: new session escapes the turn's process-group kill; stdio -> files.
    # On completion a notify job posts {"cmd":"job_done"} to the group ctl FIFO;
    # the daemon debounces + coalesces those into one self-send (notify.go).
    setsid sh -c '
      exec >"'"$D"'/out" 2>&1
      "$@"
      rc=$?
      echo "$rc" > "'"$D"'/rc"
      echo done > "'"$D"'/status"
      [ -f "'"$D"'/notify" ] && /sidecar/cs-job _notify "'"$id"'" || true
    ' _ "$@" &
    echo "$id"
    ;;
  _notify)
    # internal: post a job_done event to the group ctl FIFO, carrying the job's
    # rc + a base64 tail of its output. Under firecracker the daemon CANNOT read
    # the job dir (it lives inside workspace.img), so the result must ride the
    # ctl payload — see notify.go. The tail is capped at 1500 bytes to match the
    # daemon's old on-host trim; the full output stays readable via cs-job logs.
    # Bounded by timeout so a down ctl reader (daemon stopped) can't hang the
    # detached job — best-effort; the result is still on disk regardless.
    id=${1:?}; D=$JOBS/$id
    rc=$(cat "$D/rc" 2>/dev/null || echo '?')
    sess=$(cat "$D/session" 2>/dev/null || echo '')
    total=$(wc -c < "$D/out" 2>/dev/null | tr -d ' '); [ -n "$total" ] || total=0
    # base64 of the last 1500 bytes, newlines stripped so it's one JSON line.
    b64=$(tail -c 1500 "$D/out" 2>/dev/null | base64 | tr -d '\n')
    # session rides along so the daemon wakes the conversation that launched
    # the job, not the group's default one (notify.go).
    printf '{"cmd":"job_done","id":"%s","rc":"%s","total":%s,"session":"%s","out":"%s"}\n' \
      "$id" "$rc" "$total" "$sess" "$b64" | timeout 30 sh -c 'cat > /workspace/.cs/ctl' 2>/dev/null || true
    ;;
  spawn)
    NF=
    case "${1:-}" in
      --notify) NF=--notify; shift ;;
      --no-notify) NF=--no-notify; shift ;;
    esac
    [ $# -eq 0 ] && { echo "cs-job spawn: no prompt" >&2; exit 2; }
    exec "$0" run $NF -- cs-subagent "$@"
    ;;
  list)
    printf '%-10s %-9s %-4s %-12s %s\n' ID STATUS RC SESSION CMD
    for d in "$JOBS"/*/; do
      [ -d "$d" ] || continue
      id=$(basename "$d")
      printf '%-10s %-9s %-4s %-12s %s\n' "$id" "$(cat "$d/status" 2>/dev/null || echo ?)" \
        "$(cat "$d/rc" 2>/dev/null || echo -)" "$(cat "$d/session" 2>/dev/null || echo default)" \
        "$(cat "$d/cmd" 2>/dev/null | head -c 80)"
    done
    ;;
  wait)
    id=${1:?cs-job wait <id> [secs]}; budget=${2:-600}
    [ -d "$JOBS/$id" ] || { echo "cs-job: no such job $id" >&2; exit 2; }
    # The caller is consuming the result in-turn — cancel the completion
    # callback so the daemon doesn't ALSO wake the session with a result it
    # already has. Best-effort: a job that completed before this wait started
    # has posted already (nothing to cancel), and a completion racing the rm
    # can still slip one through — a harmless duplicate, not a loss.
    rm -f "$JOBS/$id/notify"
    waited=0
    while [ "$(jstatus "$id")" = running ]; do
      [ "$waited" -ge "$budget" ] && { echo "cs-job: wait timeout ($budget s) — job $id still running" >&2; exit 1; }
      sleep 1; waited=$((waited+1))
    done
    echo "$(jstatus "$id") rc=$(cat "$JOBS/$id/rc" 2>/dev/null || echo unknown)"
    ;;
  status)  jstatus "${1:?cs-job status <id>}" ;;
  logs)    cat "$JOBS/${1:?cs-job logs <id>}/out" 2>/dev/null || { echo "cs-job: no output for $1" >&2; exit 2; } ;;
  rm)      rm -rf "$JOBS/${1:?cs-job rm <id>}"; echo removed ;;
  clean)
    n=0
    for d in "$JOBS"/*/; do
      [ -d "$d" ] || continue
      [ "$(cat "$d/status" 2>/dev/null)" = running ] && continue
      rm -rf "$d"; n=$((n+1))
    done
    echo "removed $n"
    ;;
  *)
    echo "usage: cs-job {run [--no-notify] -- <cmd...>|spawn [--no-notify] <prompt...>|list|wait <id> [secs]|status <id>|logs <id>|rm <id>|clean}" >&2
    exit 2
    ;;
esac
