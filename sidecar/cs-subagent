#!/bin/sh
# cs-subagent — provider-agnostic ONE-SHOT LLM call.
#
# Contract (uniform across providers): prompt in (argv or stdin),
# final answer text on stdout, exit 0 on success. No streaming/log framing on
# stdout — this is a return value the caller (usually cs-job) reads as data.
# Progress (text/thinking/tool framing) streams on STDERR for both providers,
# so a cs-job out file (which merges 2>&1) shows the run live in the job view.
#
# This is the ONLY provider-aware file in the job system. cs-job is provider-blind.
#
# Isolation (must not pollute the group's main conversation thread):
#   claudesdk -> fresh `claude -p` with NO --continue, under a throwaway HOME so
#                the sub-agent session file is never written into
#                /workspace/.claude/projects (a later main --continue could
#                otherwise pick it up as "most recent").
#   venice    -> venice_stream.js in VENICE_ONESHOT mode: ephemeral in-memory
#                history (skips /workspace/.cs/venice-history.json), final text
#                to stdout, tool/progress framing to stderr.
#
# Usage: cs-subagent [--system <text>] <prompt...>
#        echo <prompt> | cs-subagent [--system <text>]
set -e

CFG=/workspace/.cs/config.json
SYS=""
if [ "$1" = "--system" ]; then SYS="$2"; shift 2; fi
# No --system given: inherit the TURN's composed system prompt (global.md +
# the group's prompt.md + memory), which fc-agent writes per session before
# every turn. It used to default to NOTHING (audit M76), so a background
# subagent ran with no harness policy at all — while still holding
# --dangerously-skip-permissions on the claude path and tool execution on the
# venice path. A delegated prompt is exactly the content most likely to carry
# an injection, and it was the one call that ran unguided.
#
# Behavioral guidance, not an authorization boundary: what actually contains a
# subagent is the microVM, the network profile and the root profile, same as
# every other turn. But "the harness is the only source of context" is a
# stated property of this system (the --bare flag exists for it), and a
# background job is not an exception to it.
if [ -z "$SYS" ]; then
  SESSFILE="/workspace/.cs/system-prompt-${KOTO_SESSION:-default}.md"
  [ -z "${KOTO_SESSION:-}" ] && SESSFILE=/workspace/.cs/system-prompt-default.md
  [ -r "$SESSFILE" ] && SYS=$(cat "$SESSFILE")
fi
PROMPT="$*"
[ -z "$PROMPT" ] && PROMPT=$(cat)
[ -z "$PROMPT" ] && { echo "cs-subagent: empty prompt" >&2; exit 2; }

# provider/model from per-group config (same node one-liner pattern as entrypoint.sh).
jget() { node -e "try{process.stdout.write((JSON.parse(require('fs').readFileSync('$CFG','utf8'))['$1']||''))}catch(e){}" 2>/dev/null; }
# claudesdk, not venice, when the read or the parse fails (audit M148). The
# daemon's defaultProvider is claudesdk and ensureProviderConfig writes it into
# any group whose config is missing or invalid, so a config this cannot read
# belongs to a claudesdk group — answering "venice" sent the system prompt and
# the workspace-derived task to a third party the operator had not selected,
# and disagreed with what the turn path (fcguest/turn.go) does with the same
# state.
PROVIDER=$(jget provider); [ -z "$PROVIDER" ] && PROVIDER=claudesdk
MODEL=$(jget model)

case "$PROVIDER" in
  claudesdk)
    H=$(mktemp -d)
    trap 'rm -rf "$H"' EXIT
    # stream-json through stream_filter.js in subagent mode (KOTO_SUBAGENT):
    # progress framing streams to stderr AS IT HAPPENS — under cs-job both fds
    # land in the job's out file, so the TUI job peek pane follows the run
    # live instead of staying blank until completion (--output-format text
    # buffered everything until the end). Only the final result text lands on
    # stdout. The filter is the pipeline's last command, so its exit status is
    # ours: it exits 1 when the stream ends without a successful result, which
    # carries a claude crash through to the job's rc despite the pipe.
    set -- claude -p "$PROMPT" --bare --dangerously-skip-permissions \
      --output-format stream-json --include-partial-messages --verbose
    [ -n "$MODEL" ] && set -- "$@" --model "$MODEL"
    [ -n "$SYS" ]   && set -- "$@" --append-system-prompt "$SYS"
    env HOME="$H" "$@" | KOTO_SUBAGENT=1 node /sidecar/stream_filter.js
    ;;
  venice)
    VM="$MODEL"; [ -z "$VM" ] && VM="${KOTO_DEFAULT_VENICE_MODEL:-kimi-k2.5}"
    MSG_B64=$(printf '%s' "$PROMPT" | base64 -w 0)
    SP_B64=""
    [ -n "$SYS" ] && SP_B64=$(printf '%s' "$SYS" | base64 -w 0)
    MSG_B64="$MSG_B64" SP_B64="$SP_B64" VENICE_MODEL="$VM" VENICE_ONESHOT=1 \
      node /sidecar/venice_stream.js
    ;;
  *)
    echo "cs-subagent: unknown provider '$PROVIDER'" >&2
    exit 2
    ;;
esac
