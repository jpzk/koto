# Golden rootfs for koto Firecracker microVM groups.
#
# Smaller than sidecar/Dockerfile (no Chrome/agent-browser), but DOES ship
# rootless podman: the agent can run containers inside the microVM. Unlike the
# old podman-in-podman "pip" path (which needed SYS_ADMIN on the host and
# collapsed isolation), here podman runs on the guest's own kernel behind KVM —
# a container escape is contained by the VM. Rootless (as node/uid 1000), with
# fuse-overlayfs storage and pasta networking over /dev/net/tun.
#
# This image is never run as a container — build-rootfs.sh exports its
# filesystem into an ext4 image that Firecracker attaches read-only as the
# root drive (shared by every group VM).
# Pinned by DIGEST so a rootfs rebuild is reproducible; `fedora:44` moves as
# the release gets updates. Bump deliberately (and rebuild the rootfs) with:
#   podman manifest inspect docker.io/library/fedora:44
FROM docker.io/library/fedora@sha256:be9d65e2344d805cc11114319c685ecaa96b6d9b4350a0a6460cdb931babbd19

# The agent CLI every guest runs, PINNED — the base image above is pinned by
# digest for exactly this reason and the npm install underneath it was not, so
# a rootfs rebuild silently adopted whatever `latest` was that day, and a
# compromised publish would have entered every guest on the next rebuild
# (audit M46). npm runs lifecycle scripts as root during the build, before the
# `node` account exists, and the result is exported as the shared read-only
# root drive attached to every VM.
#
# The version alone is not a pin: npm resolves it through the registry on
# every build, and the bytes that actually run are not in this package at all —
# @anthropic-ai/claude-code is a wrapper whose postinstall copies the binary
# out of an optionalDependency (@anthropic-ai/claude-code-linux-x64) that npm
# fetched with nothing here vouching for it. So both tarballs are downloaded
# directly and checked against the SHA-512s below (the same digests npm
# publishes as `dist.integrity`, in hex), the wrapper is unpacked where
# `npm i -g` would put it, and the native binary is placed over its stub by
# hand — exactly what its postinstall does. Not `npm i -g` itself: npm 10
# ignores --omit=optional for a global install and fetches the 223 MB native
# package from the registry anyway, unverified by us and then unused. The install path stays
# .../@anthropic-ai/claude-code/bin/claude.exe: interruptAgent finds the turn
# worker by that "claude-code" marker in /proc/PID/exe (agentWorkerPattern,
# daemon/send.go).
#
# Bump deliberately, then `make rootfs` and `/restart` the groups:
#   V=$(npm view @anthropic-ai/claude-code version)
#   for p in claude-code claude-code-linux-x64; do
#     curl -fsSL "https://registry.npmjs.org/@anthropic-ai/$p/-/$p-$V.tgz" | sha512sum
#   done
# and cross-check each against `npm view @anthropic-ai/<p>@$V dist.integrity`
# (base64 of the same digest).
ARG CLAUDE_CODE_VERSION=2.1.280
ARG CLAUDE_CODE_SHA512=119957f23a8d7fe7bbabdbfe5283db2d801b106b61eda0db713cad1f33d862885b3ff7c27eb8dba026dcbfce5960612ad51abb0269bc8572e1b822b12ec69bc0
ARG CLAUDE_CODE_LINUX_X64_SHA512=7491d616b0d2219dba85d2ee7272b77a12e6cddcd897732c3c2d51cd472d0146989d9947e647c06719caf2a611010f3d197dce3eb2ec9c576dfd09cffb40a4e9

# Security-front RPMs, PINNED by NEVRA + SHA-256 under the 6-week age gate
# (a build is eligible once its Bodhi update went stable >= 6 weeks before the
# rootfs build). Fedora's updates repo only carries the newest build of each
# package, so `dnf install curl` would silently adopt whatever was pushed this
# week. Instead the exact Fedora-signed builds are fetched from Koji's signed/
# tree (key 6d9f90a6 = RPM-GPG-KEY-44-fedora, already imported in the base
# image), checked against the digests below AND `rpm -K`, and installed before
# the package set; that install then excludes these names from the repos so
# nothing upgrades them past the pin.
# NOT age-gated (operator one-time override 2026-10-19, see notes/deps/nogate):
#   curl, libcurl  8.18.0-14.fc44     FEDORA-2026-a06b828d65  built 2026-10-12, stable 2026-10-14
#   openssl-libs   1:3.5.9-1.fc44     FEDORA-2026-12f3f3d569  built 2026-09-30, stable 2026-10-03
#   sudo           1.9.17-10.p2.fc44  FEDORA-2026-7d4732cbab  built 2026-10-07, stable 2026-10-09
#   tar            2:1.35-9.fc44      FEDORA-2026-044e56d9ff  built 2026-09-07, stable 2026-09-09
#   libevent       2.1.13-1.fc44      FEDORA-2026-72d10c874d  built 2026-09-07, stable 2026-09-09
# Bump: pick the Bodhi update (bodhi.fedoraproject.org/updates/?packages=<src>
# &releases=F44&status=stable), check date_stable against the gate, then
#   K=https://kojipkgs.fedoraproject.org/packages
#   curl -fsSL "$K/<src>/<ver>/<rel>/data/signed/6d9f90a6/x86_64/<sub>-<ver>-<rel>.x86_64.rpm" | sha256sum
RUN set -eu; mkdir /tmp/rpmpins; cd /tmp/rpmpins; \
    K=https://kojipkgs.fedoraproject.org/packages; S=data/signed/6d9f90a6/x86_64; \
    curl -fsSLO "$K/curl/8.18.0/14.fc44/$S/curl-8.18.0-14.fc44.x86_64.rpm"; \
    curl -fsSLO "$K/curl/8.18.0/14.fc44/$S/libcurl-8.18.0-14.fc44.x86_64.rpm"; \
    curl -fsSLO "$K/openssl/3.5.9/1.fc44/$S/openssl-libs-3.5.9-1.fc44.x86_64.rpm"; \
    curl -fsSLO "$K/sudo/1.9.17/10.p2.fc44/$S/sudo-1.9.17-10.p2.fc44.x86_64.rpm"; \
    curl -fsSLO "$K/tar/1.35/9.fc44/$S/tar-1.35-9.fc44.x86_64.rpm"; \
    curl -fsSLO "$K/libevent/2.1.13/1.fc44/$S/libevent-2.1.13-1.fc44.x86_64.rpm"; \
    printf '%s  %s\n' \
      c8e19f7686e0de82296338cf86aaa4fd7e506b158f0c2954318d4bc8d9559cd5 curl-8.18.0-14.fc44.x86_64.rpm \
      6ce8b5ddce7d9d481e56bb72a5384e577e20e6bb9429be8273a1c7b5b7fdb5d9 libcurl-8.18.0-14.fc44.x86_64.rpm \
      9b0efe3cf1f2ebaa3dfa0367c0cff4790c6c5d1269f2bcad53d7ace2759e0ede openssl-libs-3.5.9-1.fc44.x86_64.rpm \
      b2d42a10ec6caffa3afd3b02c04892779206e5707c451145143f84c8a7473dad sudo-1.9.17-10.p2.fc44.x86_64.rpm \
      d1d18fd2dcac33b12bc6c02d9bdf4472cc8abb951a392c57507c53aee4da3d28 tar-1.35-9.fc44.x86_64.rpm \
      5ed6be9fadb91187080d63a4036227b53fcce1db82983ab5ec24e0d6493e066f libevent-2.1.13-1.fc44.x86_64.rpm \
      | sha256sum -c -; \
    rpm -K ./*.rpm | grep -v ' digests signatures OK$' && exit 1; \
    dnf install -y --setopt=install_weak_deps=False ./*.rpm; \
    cd /; rm -rf /tmp/rpmpins

# curl, tar and sudo are deliberately NOT named here: they come from the base
# image / the pinned step above, and naming an excluded package is an error
# ("matches only excluded packages"). The rpm -q below asserts all of them.
RUN dnf install -y --setopt=install_weak_deps=False \
      --setopt=excludepkgs=curl,libcurl,libcurl-minimal,openssl,openssl-libs,sudo,tar,libevent \
      bash \
      ca-certificates \
      coreutils \
      e2fsprogs \
      git \
      iproute \
      jq \
      util-linux \
      nodejs \
      npm \
      procps-ng \
      python3 \
      ripgrep \
      gzip \
      tmux \
      which \
      podman \
      crun \
      conmon \
      containers-common \
      fuse-overlayfs \
      passt \
      slirp4netns \
      shadow-utils \
 && dnf clean all \
 && rpm --setperms $(rpm -qa) >/dev/null \
 && test -u /usr/bin/sudo \
 && rpm -q curl-8.18.0-14.fc44 libcurl-8.18.0-14.fc44 openssl-libs-3.5.9-1.fc44 \
      sudo-1.9.17-10.p2.fc44 tar-1.35-9.fc44 libevent-2.1.13-1.fc44 \
 && mkdir -p /usr/share/koto \
 && rpm -qa --qf '%{NAME}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}\t%{ARCH}\t%{SOURCERPM}\t%{BUILDTIME}\n' \
      | sort > /usr/share/koto/rpm-manifest.tsv
# ^ rpm-manifest.tsv: the exact package set + build times this rootfs shipped,
#   read by the CVE rescans (notes/cve/scripts/rpm-bodhi.sh input format plus
#   BUILDTIME) without mounting the image.

# npm CLI, replaced in place. F44's nodejs22-npm 10.9.8 bundles tar 7.5.11
# (GHSA path-traversal/symlink fixes need >= 7.5.21) and the 10.x line also
# carries brace-expansion/ip-address/sigstore/pacote advisories fixed only in
# 11.x trees. npm 11.21.1 (newest 11.x, published 2026-10-15 -- NOT age-gated,
# operator override 2026-10-19; engines node ^20.17 || >=22.9, guest has 22.23.1)
# bundles tar 7.5.22, brace-expansion 5.0.12, undici 6.29.0. The registry
# tarball is checked against its SHA-512 (= dist.integrity) and laid over the
# RPM's npm directory, keeping Fedora's builtin npmrc (prefix=/usr/local,
# update-notifier=false). npm is self-bundled: no resolution.
# Bump: curl -fsSL https://registry.npmjs.org/npm/-/npm-$V.tgz | sha512sum
#   (cross-check `npm view npm@$V dist.integrity`), update verify-rootfs.sh.
ARG NPM_VERSION=11.21.1
ARG NPM_SHA512=613ccbe90044257c87713bb426251ced128ca7e9b3949b65eeb18b98445a5d441e14720c73d6ad76be86f4cf42f2f0d66efe347a9a13400ccd2f6fcfb5954385
RUN set -eu; cd /tmp; \
    curl -fsSL -o npm.tgz "https://registry.npmjs.org/npm/-/npm-$NPM_VERSION.tgz"; \
    printf '%s  npm.tgz\n' "$NPM_SHA512" | sha512sum -c -; \
    d="$(dirname "$(dirname "$(readlink -f "$(command -v npm)")")")"; \
    test "$(jq -r .name "$d/package.json")" = npm; \
    cp "$d/npmrc" /tmp/npmrc.fedora; find "$d" -mindepth 1 -delete; \
    tar -xzf npm.tgz -C "$d" --strip-components=1 --no-same-owner; \
    mv /tmp/npmrc.fedora "$d/npmrc"; rm -f npm.tgz; \
    test "$(npm --version)" = "$NPM_VERSION"; \
    test "$(npm root -g)" = /usr/local/lib/node_modules; \
    test "$(jq -r .version "$d/node_modules/tar/package.json")" = 7.5.22

RUN set -eu; cd /tmp; \
    reg=https://registry.npmjs.org/@anthropic-ai; v="$CLAUDE_CODE_VERSION"; \
    curl -fsSL -o wrapper.tgz "$reg/claude-code/-/claude-code-$v.tgz"; \
    curl -fsSL -o native.tgz "$reg/claude-code-linux-x64/-/claude-code-linux-x64-$v.tgz"; \
    printf '%s  wrapper.tgz\n%s  native.tgz\n' \
      "$CLAUDE_CODE_SHA512" "$CLAUDE_CODE_LINUX_X64_SHA512" | sha512sum -c -; \
    dir="$(npm root -g)/@anthropic-ai/claude-code"; \
    mkdir -p "$dir"; \
    tar -xzf wrapper.tgz -C "$dir" --strip-components=1 --no-same-owner; \
    tar -xzOf native.tgz package/claude > "$dir/bin/claude.exe"; \
    chmod 0755 "$dir/bin/claude.exe"; \
    ln -sf "$dir/bin/claude.exe" /usr/local/bin/claude; \
    rm -f wrapper.tgz native.tgz; \
    claude --version | grep -qF "$v"

# Codex CLI, the agent for provider "openai" (fcguest/codex.go). The official
# prebuilt Rust binary from the openai/codex GitHub release, NOT the npm
# package: one static musl executable, no lifecycle scripts, no registry
# resolution. Pinned by version AND by the SHA-256 of the release tarball,
# checked here before anything is unpacked.
#
# Pin policy: the newest non-prerelease published at least 6 weeks before the
# build. rust-v0.152.1 was published 2026-09-01T22:33:02Z. The digest is the
# "digest" GitHub reports for the asset, cross-checked by downloading it:
#   T=rust-v0.152.1; A=codex-x86_64-unknown-linux-musl.tar.gz
#   curl -fsSL https://api.github.com/repos/openai/codex/releases/tags/$T \
#     | jq -r --arg a "$A" '.published_at, (.assets[] | select(.name==$a) | .digest)'
#   curl -fsSL "https://github.com/openai/codex/releases/download/$T/$A" | sha256sum
#
# codex-code-mode-host: a separate asset of the same release, pinned the same
# way (same CODEX_VERSION, its own SHA-256 checked before unpack). The
# code_mode_only models (gpt-5.6-*) run every tool call through it; without
# it each reply starts "Code Mode is unavailable ... host executable was not
# found" and code mode fails closed. ~69 MB unpacked. codex looks for it
# beside its own executable, not via config
# (codex-rs/install-context/src/lib.rs:172-202), hence /usr/local/bin.
# features.code_mode_host is Stable and default-on in rust-v0.152.1
# (codex-rs/features/src/lib.rs:985-990); the managed config and the turn's
# -c flag (fcguest/codex.go) set it explicitly anyway. Verify:
#   T=rust-v0.152.1; A=codex-code-mode-host-x86_64-unknown-linux-musl.tar.gz
#   curl -fsSL https://api.github.com/repos/openai/codex/releases/tags/$T \
#     | jq -r --arg a "$A" '.published_at, (.assets[] | select(.name==$a) | .digest, .size)'
#   curl -fsSL "https://github.com/openai/codex/releases/download/$T/$A" | sha256sum
#   -> 2026-09-01T22:33:02Z, sha256:0f1a544d...4191ed, 25676959 bytes; the
#      tarball holds one member, codex-code-mode-host-x86_64-unknown-linux-musl.
#
# No self-update: codex's startup update check (check_for_update_on_startup,
# codex-rs/tui/src/updates.rs) is turned off in /etc/codex/managed_config.toml,
# the managed layer that outranks the agent-writable $CODEX_HOME/config.toml,
# so an interactive `codex` in /shell never phones home for a newer release
# either. Analytics off for the same reason. Turns also pass both as -c flags.
#
# Version held at 0.152.1 on purpose (2026-10 deps audit, 6-week age gate,
# cutoff 2026-09-06). The newest eligible release, rust-v0.153.4 (09-04), has
# the same gix 0.81.0 / openssl 0.10.75 (openssl-src 3.6.3) / rustls 0.23.36 /
# hickory 0.25.2 / zip 2.4.2 as 0.152.1, so bumping closes no advisory.
# rustls 0.23.45 first ships in 0.156.0 (09-22, eligible 2026-11-03). No
# release up to 0.163.0 bumps gix or openssl yet. Re-check the Cargo.lock at
# codex-rs/Cargo.lock for the tag before bumping.
ARG CODEX_VERSION=0.152.1
ARG CODEX_SHA256=a0ed1b40b1d597b340f09ae00ecebc46670b06cb52aac315b9dc84fed0289fd0
ARG CODEX_CODE_MODE_HOST_SHA256=0f1a544d5c1e89aed769a91d8e63421eb8eef9db554e861ed90704126a4191ed

RUN set -eu; cd /tmp; \
    a=codex-x86_64-unknown-linux-musl; \
    curl -fsSL -o codex.tgz \
      "https://github.com/openai/codex/releases/download/rust-v$CODEX_VERSION/$a.tar.gz"; \
    printf '%s  codex.tgz\n' "$CODEX_SHA256" | sha256sum -c -; \
    tar -xzOf codex.tgz "$a" > /usr/local/bin/codex; \
    chmod 0755 /usr/local/bin/codex; \
    h=codex-code-mode-host-x86_64-unknown-linux-musl; \
    curl -fsSL -o cmhost.tgz \
      "https://github.com/openai/codex/releases/download/rust-v$CODEX_VERSION/$h.tar.gz"; \
    printf '%s  cmhost.tgz\n' "$CODEX_CODE_MODE_HOST_SHA256" | sha256sum -c -; \
    tar -xzOf cmhost.tgz "$h" > /usr/local/bin/codex-code-mode-host; \
    chmod 0755 /usr/local/bin/codex-code-mode-host; \
    rm -f codex.tgz cmhost.tgz; \
    mkdir -p /etc/codex; \
    printf 'check_for_update_on_startup = false\n\n[analytics]\nenabled = false\n\n[features]\ncode_mode_host = true\n' \
      > /etc/codex/managed_config.toml; \
    chmod 0644 /etc/codex/managed_config.toml; \
    test "$(codex --version)" = "codex-cli $CODEX_VERSION"; \
    codex-code-mode-host --help | grep -qF -- '--listen <URL>'

# pi coding agent, installed from npm with a committed lockfile.
# The self-contained Linux archive (pi-linux-x64.tar.gz, a bun single binary)
# compiles its deps in, so they cannot be patched or audited. pi 0.86.0
# (published 2026-09-19 -- NOT age-gated, operator override 2026-10-19) locks
# undici 8.10.2 itself, so the 0.85.1 undici override is gone.
# fcguest/pi/install/ is that release's own installer root
# (pi-coding-agent-install-package{,-lock}.json, sha256 per its SHA256SUMS:
# 0a5c4663…9d503 / b7a6f64d…df909) with exactly two edits:
#   - overrides.brace-expansion = 5.0.12 (published 2026-09-14; upstream locks
#     5.0.9 via minimatch ^5.0.8), lock entry swapped to its tarball + integrity;
#   - the six @earendil-works/* 0.86.0 entries upstream left without an
#     integrity got their registry dist.integrity filled in (each checked
#     against the downloaded tarball's SHA-512).
# Every entry carries a SHA-512, so `npm ci` installs exactly these bytes.
# Lifecycle scripts are skipped (esbuild/protobufjs/@google/genai do not need
# them at runtime; platform binaries arrive as optionalDependencies).
# The receipt records the lockfile digest for verify-rootfs.sh.
# Bump: take the new release's two installer files, re-apply the edits above
# (drop the override once the release locks brace-expansion >= 5.0.12), update
# PI_VERSION and PI_LOCK_SHA256 (= sha256sum fcguest/pi/install/package-lock.json)
# here and in verify-rootfs.sh.
ARG PI_VERSION=0.86.0
ARG PI_LOCK_SHA256=510555c39ab4734446f6984762c9de67fd1fcd3400d3165a6da04251bad85e6b
COPY fcguest/pi/install/package.json fcguest/pi/install/package-lock.json /opt/pi/
RUN set -eu; cd /opt/pi; \
    printf '%s  package-lock.json\n' "$PI_LOCK_SHA256" | sha256sum -c -; \
    npm ci --ignore-scripts --omit=dev --no-audit --no-fund --loglevel=warn; \
    npm cache clean --force; \
    printf '%s  %s\n' "$PI_LOCK_SHA256" package-lock.json > /opt/pi/.artifact.sha256; \
    ln -s node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js /opt/pi/pi; \
    ln -s /opt/pi/pi /usr/local/bin/pi; \
    chmod -R a+rX /opt/pi; \
    test "$(pi --version)" = "$PI_VERSION"; \
    test "$(jq -r .version /opt/pi/package.json)" = "$PI_VERSION"; \
    test "$(jq -r .version node_modules/@earendil-works/pi-coding-agent/package.json)" = "$PI_VERSION"; \
    test "$(jq -r .version node_modules/undici/package.json)" = 8.10.2; \
    test -z "$(find /opt/pi -path '*/node_modules/undici/package.json' -exec jq -r 'select(.version != "8.10.2") | .version' {} +)"; \
    test -z "$(find /opt/pi -path '*/node_modules/brace-expansion/package.json' -exec jq -r 'select(.version != "5.0.12") | .version' {} +)"

# pi must stay local and quiet in every guest execution path. Keep these
# provider-neutral: provider credentials and endpoints arrive separately at
# runtime, and a later runPi implementation can reuse the same rootfs policy.
ENV PI_OFFLINE=1 \
    PI_TELEMETRY=0 \
    PI_SKIP_VERSION_CHECK=1

# Guest-side pi provider templates (fcguest/pi/README.md). Read-only in the
# image; a launcher copies the one for the group's provider into
# $PI_CODING_AGENT_DIR/models.json. They hold only the in-guest proxy URL and
# a placeholder key — the real provider key stays on the host.
COPY fcguest/pi/models.minimax.json /usr/local/share/koto/pi/models.minimax.json
RUN chmod 0644 /usr/local/share/koto/pi/models.minimax.json

# Same uid/gid contract as the podman sidecar: every worker (claude, venice_stream.js, jobs) runs as node
# (uid 1000) because `claude --dangerously-skip-permissions` refuses root.
RUN useradd -u 1000 -m -s /bin/bash node

# `sudo` ships in the image, but the NOPASSWD grant for node is NOT baked here —
# it's gated per group by config.json "root"=yes|no and installed at boot by
# fc-agent (handleInit → enableRoot), which also mounts persistent overlays on
# /usr /etc /var /opt (upper on the workspace disk) so `sudo dnf install`
# persists without ever writing this shared read-only image. The microVM's KVM
# boundary contains root-in-guest, so granting sudo does not widen the host
# blast radius (see docs/firecracker-vsock.md / the trust model).

# Rootless podman setup for node:
#  - subuid/subgid: a subordinate id range so newuidmap can build the userns.
#  - storage.conf: overlay via fuse-overlayfs (no host overlay privilege).
#  - containers.conf: cgroupfs + file logger (no systemd in the guest); pasta
#    networking (rootless, uses /dev/net/tun). graphroot lands under
#    $HOME=/workspace (the writable ext4), not the read-only root.
RUN printf 'node:100000:65536\n' > /etc/subuid \
 && printf 'node:100000:65536\n' > /etc/subgid \
 && mkdir -p /etc/containers \
 && printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' > /etc/containers/storage.conf \
 && printf '[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\nruntime = "crun"\n[network]\ndefault_rootless_network_cmd = "pasta"\n' > /etc/containers/containers.conf \
 && chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap
# ^ setuid bit, not file caps: mke2fs -d / the export tar don't carry the
#   security.capability xattr, so rely on setuid-root for the id-map helpers.

# Disable tmux's status bar for the shared-shell session (fcguest/main.go's
# shell_attach spawns `tmux new-session`) — stock tmux defaults to a green
# status line, which is otherwise the first thing rendered in every /shell
# attach. /etc/tmux.conf is read before any per-user config, so this applies
# regardless of which user starts the session.
RUN printf 'set -g status off\n' > /etc/tmux.conf

# Sidecar loop scripts, baked in (no bind mounts in a microVM — editing them
# now requires `make fc-rootfs`, unlike the podman runtime's live mounts).
COPY sidecar/ /sidecar/
RUN chmod -R a+rX /sidecar

# The PID-1 agent. boot_args select it: init=/usr/local/bin/fc-agent
# /workspace + /skills must pre-exist as mount points — the root drive is
# attached read-only, so the agent can't create them at boot.
COPY fcguest/fc-agent /usr/local/bin/fc-agent
RUN chmod 755 /usr/local/bin/fc-agent \
 && mkdir -p /workspace /skills \
 && printf '127.0.0.1 localhost koto-vm\n' > /etc/hosts
# NB: /etc/resolv.conf is fixed up in build-rootfs.sh (staging tree), not here —
# podman bind-mounts /etc/resolv.conf during build, so a RUN can't replace it.
