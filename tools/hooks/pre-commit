#!/bin/sh
# pre-commit: refuse a commit that stages a secret.
#
# Runs betterleaks over the STAGED changes only (a second or so, most of it
# container start-up), so the check that matters — "is a credential about to
# enter history" — happens before the commit exists, where undoing it is
# `git reset` and not a history rewrite plus a key rotation. The whole-history
# sweep with both scanners is `make secrets-scan`; this hook is the per-commit
# gate. Install it with `make hooks` (sets core.hooksPath to this directory).
#
# betterleaks rather than gitleaks: same author (who left gitleaks after losing
# control of the repo — gitleaks has had no release since v8.30.1, 2026-03),
# drop-in flags and config, and entropy replaced by a BPE token-efficiency
# score, which is the exact heuristic our canaries found wanting. Detection on
# koto's own shapes was identical between the two on 2026-09-05: both flag the
# sk-ant-api03- API-key shape, PEM private keys and a hex string assigned to a
# variable named like a secret; NEITHER flags the sk-ant-oat01- OAuth token or
# a bare 64-hex token file. So this hook is a net for the recognisable shapes
# and for other people's keys; keeping creds/ out of the tree is still
# .gitignore's job, and `make secrets-scan` greps history for the live values
# verbatim to cover what no pattern scanner can.
#
# Bypass for a known false positive: `git commit --no-verify`, or add an
# allowlist entry to .betterleaks.toml at the repo root (picked up
# automatically; the default rules are in use until it exists).
#
# Image pinned by DIGEST, ≥6 weeks old like every dependency here
# (betterleaks v1.7.0, released 2026-07-23). A native `betterleaks` on PATH is
# preferred when present — no container start-up cost.

set -eu

repo=$(git rev-parse --show-toplevel)
BETTERLEAKS_IMAGE=ghcr.io/betterleaks/betterleaks@sha256:06d60954c287c19af7a7171a1b5d466959d2f49b6946d4cf92ea65ba725a633a

if command -v betterleaks >/dev/null 2>&1; then
	cd "$repo"
	exec betterleaks git --pre-commit --staged --no-banner --redact=100 .
fi

engine=$(command -v podman 2>/dev/null || command -v docker 2>/dev/null || true)
if [ -z "$engine" ]; then
	echo "pre-commit: neither betterleaks nor podman/docker found — cannot scan for secrets." >&2
	echo "pre-commit: install betterleaks, or bypass once with: git commit --no-verify" >&2
	exit 1
fi

# The index is what --staged reads, so the repo (with .git) is mounted, read-
# only. Root inside a rootless container is this user outside, but git still
# checks the .git owner against the uid it sees, hence safe.directory.
exec "$engine" run --rm --security-opt label=disable \
	-v "$repo:/src:ro" -w /src \
	-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/src \
	"$BETTERLEAKS_IMAGE" git --pre-commit --staged --no-banner --redact=100 /src
