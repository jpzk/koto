#!/bin/sh
# pre-commit: the checks every Go project runs at commit time, fast → slow.
#
#   1. gofmt      staged .go files must be gofmt-clean         (milliseconds)
#   2. go vet     every module with a staged .go file           (~1-3s, cached)
#   3. go mod tidy -diff   go.mod/go.sum must match imports     (~1s per module)
#   4. betterleaks  no secret in the staged diff               (~1s, container)
#
# Only the STAGED content is judged wherever the tool allows it: gofmt reads
# each file out of the index (`git show :path`), so a partially staged file is
# checked as it will be committed, not as it sits in the tree. vet and tidy
# have to see a whole package on disk, so they run on the working tree of the
# affected module — the usual compromise, and the one every Go hook makes.
#
# The Go checks need a Go toolchain. An INSTALLED koto deliberately needs no
# Go on the host, and a dev machine may keep it in ~/.local/go (assemble does),
# so the hook looks there too and, finding none, SKIPS the Go checks with a
# warning rather than refusing the commit — a hook that blocks on a toolchain
# the project says you don't need would just train `--no-verify`. The secrets
# scan is never skipped for that reason.
#
# Bypass once: `git commit --no-verify`. Install: `make hooks` (sets
# core.hooksPath to this directory). The whole-history secrets sweep with both
# scanners is `make secrets-scan`; this hook is the per-commit gate.
#
# Secrets scanner: betterleaks rather than gitleaks — same author (who left
# gitleaks after losing control of the repo; gitleaks has had no release since
# v8.30.1, 2026-03), drop-in flags and config, entropy replaced by a BPE
# token-efficiency score. Detection on koto's own shapes was identical between
# the two on 2026-09-05: both flag the sk-ant-api03- API-key shape, PEM private
# keys and a hex string assigned to a variable named like a secret; NEITHER
# flags the sk-ant-oat01- OAuth token or a bare 64-hex token file. So the scan
# is a net for the recognisable shapes and for other people's keys; keeping
# creds/ out of the tree is .gitignore's job, and `make secrets-scan` greps
# history for the live values verbatim to cover what no pattern scanner can.
# Allowlist a false positive in .betterleaks.toml at the repo root (picked up
# automatically). Image pinned by DIGEST, ≥6 weeks old like every dependency
# (v1.7.0, 2026-07-23); a native `betterleaks` on PATH is preferred.

set -u

repo=$(git rev-parse --show-toplevel)
cd "$repo"
BETTERLEAKS_IMAGE=ghcr.io/betterleaks/betterleaks@sha256:06d60954c287c19af7a7171a1b5d466959d2f49b6946d4cf92ea65ba725a633a

fail() { printf 'pre-commit: %s\n' "$*" >&2; exit 1; }
note() { printf 'pre-commit: %s\n' "$*" >&2; }

# Staged Go files (added/copied/modified/renamed — a deletion has nothing to
# format). Generated protobuf code is excluded from gofmt: it is protoc's
# output, verified by `make proto-verify`, not something a commit edits.
staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' | grep -v '\.pb\.go$' || true)

# Staged module manifests. These are checked EVEN WHEN NO .go FILE IS STAGED
# (audit 2026-09-11 L101): the whole block used to hang off $staged_go, and the
# manifest discovery inside it could not help because it was itself inside the
# skipped block — so a commit that changes only go.mod/go.sum/go.work, which is
# exactly the shape of a dependency bump, ran none of vet, tidy or gofmt. That
# is the change this project most wants a local check on: the six-week pin rule
# and the security-fix exception both live in those files.
staged_mod=$(git diff --cached --name-only --diff-filter=ACMR -- '*go.mod' '*go.sum' 'go.work' 'go.work.sum' || true)

if [ -n "$staged_go" ] || [ -n "$staged_mod" ]; then
	go=""
	for cand in "$(command -v go 2>/dev/null || true)" "$HOME/.local/go/bin/go" /usr/local/go/bin/go; do
		[ -n "$cand" ] && [ -x "$cand" ] && { go=$cand; break; }
	done
	if [ -z "$go" ]; then
		note "no Go toolchain found (PATH, ~/.local/go, /usr/local/go) — skipping gofmt/vet/tidy on staged .go files"
	else
		gofmt="$(dirname "$go")/gofmt"
		[ -x "$gofmt" ] || gofmt="gofmt"

		# 1. gofmt, on the INDEX content of each staged file.
		bad=""
		for f in $staged_go; do
			if [ -n "$(git show ":$f" | "$gofmt" -l 2>/dev/null)" ]; then
				bad="$bad $f"
			fi
		done
		[ -z "$bad" ] || fail "not gofmt-clean:$bad
  fix:  gofmt -w$bad && git add$bad"

		# Modules touched: the first path component is the module dir in this
		# monorepo (daemon/ fcguest/ tui/ protocol/), each with its own go.mod.
		# A root go.work change has no module dir of its own, so it stands in
		# for every module — a workspace edit can change what any of them
		# resolves to.
		if git diff --cached --name-only --diff-filter=ACMR -- 'go.work' 'go.work.sum' | grep -q .; then
			mods=$(for f in */go.mod; do [ -f "$f" ] && echo "${f%%/*}"; done | sort -u)
		else
			mods=$(for f in $staged_go $staged_mod; do
				d=${f%%/*}; [ -f "$d/go.mod" ] && echo "$d"; done | sort -u)
		fi

		for m in $mods; do
			# 2. go vet — the compiler's suspicious-construct pass: printf
			# arguments vs verbs, copied locks, unreachable code, misuse of
			# unsafe, struct tags, and the rest of `go tool vet help`.
			(cd "$m" && "$go" vet ./...) || fail "go vet failed in $m/"
			# 3. go mod tidy -diff — exits non-zero (and prints the diff) when
			# go.mod/go.sum would change, i.e. an import was added or dropped
			# without tidying, or a sum is missing.
			(cd "$m" && "$go" mod tidy -diff >/dev/null 2>&1) || fail "go.mod/go.sum out of date in $m/
  fix:  (cd $m && go mod tidy) && git add $m/go.mod $m/go.sum"
		done
	fi
fi

# 4. secrets. The index is what --staged reads, so the repo (with .git) is
# mounted read-only. Root inside a rootless container is this user outside,
# but git still checks the .git owner against the uid it sees, hence
# safe.directory.
if command -v betterleaks >/dev/null 2>&1; then
	exec betterleaks git --pre-commit --staged --no-banner --redact=100 .
fi
engine=$(command -v podman 2>/dev/null || command -v docker 2>/dev/null || true)
[ -n "$engine" ] || fail "neither betterleaks nor podman/docker found — cannot scan for secrets (install betterleaks, or bypass once: git commit --no-verify)"
# --network=none is the load-bearing flag here. The scanner needs the repo
# WITH .git to read the index, so it can read the whole checkout — git history,
# ignored files, and creds/ among them — and read-only prevents writes, not
# reads. A digest pin stops a mutable tag being swapped, but it is not a
# confidentiality boundary: if the image, its build pipeline or the registry
# account were compromised, the only thing standing between it and the
# operator's credentials is having nowhere to send them (audit M100).
#
# The rest is ordinary least privilege for a process that only reads files:
# no capabilities, no privilege escalation, a read-only root with a tmpfs for
# whatever scratch it wants. label=disable stays — Fedora's SELinux policy
# denies the bind mount otherwise, which is the same trade the project makes
# everywhere else.
exec "$engine" run --rm --security-opt label=disable \
	--network=none --cap-drop=ALL --security-opt=no-new-privileges \
	--read-only --tmpfs /tmp \
	-v "$repo:/src:ro" -w /src \
	-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/src \
	"$BETTERLEAKS_IMAGE" git --pre-commit --staged --no-banner --redact=100 /src
